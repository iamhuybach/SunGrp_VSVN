{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit(/.ai/tasks/*/architecture.md)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "WebSearch",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:docs.delta.io)",
      "WebFetch(domain:spark.apache.org)",
      "WebFetch(domain:debezium.io)",
      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:docs.oracle.com)",
      "WebFetch(domain:java.testcontainers.org)",
      "WebFetch(domain:hibernate.org)",
      "WebFetch(domain:www.postgresql.org)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(Remove-Item *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/git_guard.py --runtime claude"
          }
        ]
      }
    ]
  }
}
