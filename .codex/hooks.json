{
  "description": "VSVN: deny push, reset, rebase, amend, history rewrite, clean, and recursive delete (AGENTS.md section 8). Trust once with /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import runpy,subprocess,sys;r=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip();sys.argv=[r+'/scripts/hooks/git_guard.py','--runtime','codex'];runpy.run_path(sys.argv[0],run_name='__main__')\"",
            "statusMessage": "VSVN git guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
